<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Мультиплеер Тест</title>
<style>
  body { margin: 0; overflow: hidden; background: #111; touch-action: none; }
  canvas { display: block; }
  
  /* Простой джойстик для телефона */
  #joyBase {
    position:fixed; bottom:20px; left:20px; width:90px; height:90px;
    border:2px solid rgba(255,255,255,0.5); border-radius:50%;
    z-index:15; background:rgba(0,0,0,0.3); display: none;
  }
  #joyKnob {
    position:absolute; top:25px; left:25px; width:40px; height:40px;
    background:rgba(255,255,255,0.8); border-radius:50%; pointer-events:none;
  }
</style>

<!-- Сначала подключаем Three.js (3D-движок) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<!-- Затем подключаем NetplayJS (сеть) -->
<script src="https://unpkg.com/netplayjs@0.4.1/dist/netplay.js"></script>
</head>
<body>

<div id="joyBase"><div id="joyKnob"></div></div>

<script>
// Настройка джойстика
const joyBase = document.getElementById('joyBase');
const joyKnob = document.getElementById('joyKnob');
let joyActive = false, joyStart = {x:0,y:0};
let touchMoveVec = {x:0, y:0};

joyBase.addEventListener('touchstart', e=>{ e.stopPropagation(); joyActive = true; const r = joyBase.getBoundingClientRect(); joyStart = { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top }; e.preventDefault(); }, {passive:false});
joyBase.addEventListener('touchmove', e=>{ e.stopPropagation(); if (!joyActive) return; const r = joyBase.getBoundingClientRect(); let dx = e.touches[0].clientX - r.left - joyStart.x, dy = e.touches[0].clientY - r.top - joyStart.y; const len = Math.hypot(dx, dy), max = 30; if (len > max) { dx *= max/len; dy *= max/len; } joyKnob.style.left = (25 + dx) + 'px'; joyKnob.style.top = (25 + dy) + 'px'; touchMoveVec.x = dx / max; touchMoveVec.y = dy / max; e.preventDefault(); }, {passive:false});
joyBase.addEventListener('touchend', e=>{ e.stopPropagation(); joyActive = false; touchMoveVec = {x:0,y:0}; joyKnob.style.left = '25px'; joyKnob.style.top = '25px'; e.preventDefault(); }, {passive:false});


// Класс игры для NetplayJS
class MyShooterGame extends netplayjs.Game {
  constructor() {
    super();
    // Игроки
    this.players = {
      0: { x: 0, y: 1.6, z: 0 },
      1: { x: 5, y: 1.6, z: 5 }
    };
  }

  tick(playerInputs) {
    for (const [player, input] of playerInputs.entries()) {
      const id = player.getID();
      const p = this.players[id];
      if (!p) continue;

      let speed = 0.15;
      
      // Управление с клавиатуры
      if (input.pressed.ArrowUp) p.z -= speed;
      if (input.pressed.ArrowDown) p.z += speed;
      if (input.pressed.ArrowLeft) p.x -= speed;
      if (input.pressed.ArrowRight) p.x += speed;

      // Управление с джойстика (только для своего игрока)
      // NetplayJS передает нам ID, но мы не знаем, какой это палец. 
      // Поэтому мы применяем тач-вектор к тому игроку, который запущен на этом клиенте.
      if (id === netplayjs.getLocalPlayerID()) {
        p.x += touchMoveVec.x * speed;
        p.z += touchMoveVec.y * speed;
      }
    }
  }

  draw(canvas) {
    if (!this.scene) {
      this.scene = new THREE.Scene();
      this.scene.background = new THREE.Color(0x87CEEB);
      this.scene.fog = new THREE.Fog(0x87CEEB, 20, 100);
      
      this.camera = new THREE.PerspectiveCamera(75, canvas.width / canvas.height, 0.1, 1000);
      
      this.renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
      this.renderer.setSize(canvas.width, canvas.height);
      
      const light = new THREE.DirectionalLight(0xffffff, 1.2);
      light.position.set(10, 20, 10);
      this.scene.add(light);
      
      const groundGeo = new THREE.PlaneGeometry(200, 200);
      const groundMat = new THREE.MeshStandardMaterial({ color: 0x4a7a2a });
      const ground = new THREE.Mesh(groundGeo, groundMat);
      ground.rotation.x = -Math.PI / 2;
      this.scene.add(ground);

      // Деревья (для ориентира)
      for(let i=0; i<50; i++) {
        const tree = new THREE.Mesh(new THREE.ConeGeometry(1, 3, 5), new THREE.MeshStandardMaterial({color: 0x1e5a2a}));
        tree.position.set((Math.random()-0.5)*80, 1.5, (Math.random()-0.5)*80);
        this.scene.add(tree);
      }

      this.playerMeshes = {};
      
      // Игрок 0 (Красный)
      this.playerMeshes[0] = new THREE.Mesh(new THREE.BoxGeometry(1, 2, 1), new THREE.MeshStandardMaterial({ color: 0xff0000 }));
      this.scene.add(this.playerMeshes[0]);

      // Игрок 1 (Синий)
      this.playerMeshes[1] = new THREE.Mesh(new THREE.BoxGeometry(1, 2, 1), new THREE.MeshStandardMaterial({ color: 0x0000ff }));
      this.scene.add(this.playerMeshes[1]);

      // Показываем джойстик
      joyBase.style.display = 'block';
    }

    // Обновляем кубы
    for (const id in this.players) {
      if (this.playerMeshes[id]) {
        this.playerMeshes[id].position.set(this.players[id].x, this.players[id].y - 1, this.players[id].z);
      }
    }

    // Камера
    const localId = netplayjs.getLocalPlayerID();
    const myPos = this.players[localId];
    if (myPos) {
      this.camera.position.set(myPos.x, myPos.y, myPos.z + 5); // Камера сзади
      this.camera.lookAt(myPos.x, myPos.y, myPos.z);
    }

    this.renderer.render(this.scene, this.camera);
  }
}

MyShooterGame.timestep = 1000 / 60;
MyShooterGame.canvasSize = { width: window.innerWidth, height: window.innerHeight };

new netplayjs.RollbackWrapper(MyShooterGame).start();
</script>
</body>
</html>
